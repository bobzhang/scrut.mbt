///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/random",
}

///|
/// Oracle for argv/: how bash splits random command strings into words.
///
/// For each string S, runs `bash -c "printf '%s\0' __W__ S"` and records the
/// words (or that bash failed). Prints the table argv/oracle_cases_test.mbt:
///
///     moonx scripts/argv_oracle.mbtx > argv/oracle_cases_test.mbt
async fn main {
  // Globs must not match anything.
  let empty_dir = @fs.tmpdir(prefix="argv-oracle")
  let bash = find_bash()
  let rng = Rng::new(0xA56)
  let commands = Array::makei(4000, _ => {
    let n = rng.randint(1, 6)
    let s = StringBuilder()
    for _ in 0..<n {
      s.write_string(rng.choice(pieces))
    }
    s.to_string()
  })
  let cases = @async.all(
    commands.map(s => async fn() { (s, bash_words(bash, s, empty_dir)) }),
    max_concurrent=8,
  )
  @fs.rmdir(empty_dir, recursive=true)
  println("// Generated by scripts/argv_oracle.mbtx; DO NOT EDIT.\n")
  println("///|\n/// The environment of the commands.")
  println("let argv_env : Array[(String, String)] = [")
  for kv in env {
    println("  (\{mbt(kv.0)}, \{mbt(kv.1)}),")
  }
  println("]\n")
  println("///|\n/// (command, bash's words or None when bash fails)")
  println("let argv_cases : Array[(String, Array[String]?)] = [")
  for case in cases {
    let (s, words) = case
    let w = match words {
      None => "None"
      Some(words) => "Some([" + words.map(mbt).join(", ") + "])"
    }
    println("  (\{mbt(s)}, \{w}),")
  }
  println("]")
}

///|
let pieces : Array[String] = [
  "a", "b", "foo", "x y", " ", "  ", "\t", "'", "\"", "\\", "\\\n", "\n", "'a b'",
  "\"a b\"", "\"\\\"\"", "\"\\$\"", "\"\\x\"", "'\\'", "\"\"", "''", "=", "A=b",
  "_x=1", "1=2", "~", "~/x", "#", "a#b", "!", "|", ";", "&", "<", ">", "(", ")",
  "`", "$", "$HOME", "*", "?", "[", "]", "{", "}", ",", "é", "中", "😀", "a\\ b",
  "\"a\\\\b\"", "'\"'", "\"'\"", "-n", "--flag=v", "\"\n\"", "'\n'", "X=~", "X=a:~",
  "%", "^", "@", ":", "\"$FOO\"", "\"${FOO}x\"", "\"$FOO_bar\"", "\"$UNSET\"", "\"${EMPTY}\"",
  "\"$X1\"", "\"a$FOO\"", "\"$1\"", "\"$?\"", "\"${FOO:-x}\"", "\"$RANDOM\"", "\"$\"",
  "\"${\"", "\"$STAR\"", "\"$TESTDIR/f\"", "X=\"$FOO\"", "\"$FOO$X1\"", "\"${X1}${FOO}\"",
  "\"\\$FOO\"", "'$FOO'", "\"$FOO\"'$X1'",
]

///|
/// Variables of the bash environment (also passed to our tokenizer).
let env : Array[(String, String)] = [
  ("PATH", "/usr/bin:/bin"),
  ("LC_ALL", "C.UTF-8"),
  ("FOO", "a b"),
  ("EMPTY", ""),
  ("X1", "x1"),
  ("STAR", "*"),
  ("TESTDIR", "/t d"),
]

///|
/// bash, looked up on the environment's PATH.
async fn find_bash() -> String {
  for dir in ["/usr/bin", "/bin"] {
    if @fs.exists(dir + "/bash") {
      return dir + "/bash"
    }
  }
  fail("no bash in /usr/bin or /bin")
}

///|
/// The words bash splits `s` into, or `None` when it fails.
async fn bash_words(bash : String, s : String, cwd : String) -> Array[String]? {
  let script = "printf '%s\\0' __W__ " + s
  let (code, out, err) = @process.collect_output(
    bash,
    ["--norc", "--noprofile", "-c", script],
    extra_env=Map::from_array(env),
    inherit_env=false,
    cwd~,
  )
  if code != 0 || err.binary().length() > 0 {
    return None
  }
  let words = @utf8.decode_lossy(out.binary())
    .split("\u{0}")
    .map(w => w.to_owned())
    .to_array()
  ignore(words.pop())
  if words.is_empty() || words[0] != "__W__" {
    return None
  }
  Some(words[1:].to_owned())
}

///|
/// A MoonBit string literal.
fn mbt(s : String) -> String {
  let out = StringBuilder()
  out.write_char('"')
  for c in s {
    match c {
      '"' => out.write_string("\\\"")
      '\\' => out.write_string("\\\\")
      '\n' => out.write_string("\\n")
      '\t' => out.write_string("\\t")
      '\r' => out.write_string("\\r")
      c if c.to_int() < 0x20 =>
        out.write_string("\\u{\{c.to_int().to_string(radix=16)}}")
      c => out.write_char(c)
    }
  }
  out.write_char('"')
  out.to_string()
}

///|
/// A deterministic random generator seeded with an integer.
struct Rng(@random.Rand)

///|
fn Rng::new(seed : Int) -> Rng {
  let bytes = Array::make(32, b'\x00')
  for i in 0..<4 {
    bytes[i] = ((seed >> (8 * i)) & 0xFF).to_byte()
  }
  Rng(@random.Rand::chacha8(seed=Bytes::from_array(bytes)))
}

///|
/// A random integer in [lo, hi].
fn Rng::randint(self : Rng, lo : Int, hi : Int) -> Int {
  lo + self.0.int(limit=hi - lo + 1)
}

///|
fn[T] Rng::choice(self : Rng, xs : Array[T]) -> T {
  xs[self.0.int(limit=xs.length())]
}
